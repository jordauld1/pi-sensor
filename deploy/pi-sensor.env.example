# Per-room settings, read by systemd (EnvironmentFile=) before the service starts.
# Install root-only so the token isn't readable by other users:
#   sudo install -m 600 -o root -g root deploy/pi-sensor.env.example /etc/pi-sensor.env
#   sudo nano /etc/pi-sensor.env
INFLUXDB_TOKEN=
SENSOR_LOCATION=bedroom3
# Optional. Leave commented to use the defaults in ens160AirQualitySensor.py.
#INFLUXDB_URL=http://192.168.1.10:8086
#INFLUXDB_ORG=raider
#INFLUXDB_BUCKET=sensorData
#LOG_LEVEL=INFO
